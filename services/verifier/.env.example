# =============================================================
# Verifier Service Environment Template (Least Privilege)
# Port: 8002 (Local) or Render Free Tier (Public)
# Workers MUST NOT receive database credentials or other worker tokens.
# =============================================================

PORT=8002
HOST=0.0.0.0

# Service Bearer Token (required for POST /verify)
VERIFIER_TOKEN=replace_with_secure_verifier_token

# Model Credentials for Claim Verification
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
