# =============================================================
# Researcher Service Environment Template (Least Privilege)
# Port: 8001
# Workers MUST NOT receive database credentials or other worker tokens.
# =============================================================

PORT=8001
HOST=0.0.0.0

# Service Bearer Token (required for POST /research)
RESEARCHER_TOKEN=replace_with_secure_researcher_token

# Model & Discovery Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=your_groq_api_key_here
