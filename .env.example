# ==============================================================================
# FNMS Assignment 1B: Environment Variables Template
# Copy this file to .env at the root directory and fill in your keys:
# cp .env.example .env
# ==============================================================================

# 1. OpenRouter API Key (Mandatory for default LLM provider)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Tavily Search API Key (Mandatory for web search)
# Get a free key (1,000 monthly credits) at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Optional: Groq API Key (For ultra-fast fallback provider)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 4. Optional: Tracker Execution Account Override (Defaults to NYUgrader)
TRACKER_USER=NYUgrader
TRACKER_PASSWORD=Courant2026!
BACKEND_URL=http://localhost:8000
