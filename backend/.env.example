# =============================================================
# Database Connection URL
# =============================================================
# Option A: Cloud PostgreSQL (Recommended: Neon Serverless Postgres)
# e.g., postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Option B: Local Persistent SQLite (Survives service restarts)
DATABASE_URL=sqlite:///./app.db

# =============================================================
# JWT Authentication & Security Configuration
# =============================================================
# Secret key used for signing JWT access tokens (HMAC-SHA256)
JWT_SECRET=fnms-course-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# =============================================================
# Server Network Settings
# =============================================================
PORT=8000
HOST=0.0.0.0
